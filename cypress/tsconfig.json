{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["cypress", "node"],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "../cypress.config.ts",
    "../src/**/*.d.ts"
  ],
  "exclude": ["frontend"]
}
